{
  "title": "Enterprise AI Gateway Observability",
  "uid": "ai-gateway-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Total Requests & Guardrail Blocks (2xx vs 4xx)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "http_requests_total{handler=\"/chat\"}",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average Request Latency (Seconds)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum{handler=\"/chat\"}[1m]) / rate(http_request_duration_seconds_count{handler=\"/chat\"}[1m])",
          "legendFormat": "Avg Latency (s)",
          "refId": "A"
        }
      ]
    }
  ]
}