# Groq API Key (Primary Provider - Qwen 3.8 27B)
# Obtain from https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# Google Gemini API Key (Fallback Provider - Gemini 2.5 Flash)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# LiteLLM Proxy Master Key (Admin authentication for LiteLLM router)
LITELLM_MASTER_KEY="sk-enterprise-gateway-master-key"

# LiteLLM Gateway Endpoint URL
# Use http://localhost:4000/v1 for standalone local execution
# Use http://litellm:4000/v1 when running within Docker Compose
LITELLM_BASE_URL="http://localhost:4000/v1"

# Redis Cache Settings (optional for standalone local run; defaults to redis:6379 in Docker)
REDIS_HOST="localhost"
REDIS_PORT="6379"
